# Optional existing host application origin, e.g. https://your-host.example.
# Leave blank to show the standalone member-services preview.
VITE_PLATFORM_URL=

# Set to false to turn off demo accounts before building. Unset enables local dev
# and local Laravel builds on loopback addresses.
# VITE_ENABLE_DEMO_ACCOUNTS=false

# Local-only database authentication test page. Never enable on public builds.
# VITE_ENABLE_LOCAL_LARAVEL_AUTH=true

# Use the Laravel sign-in and dashboard on the local Vite or Laravel build.
# VITE_ENABLE_LARAVEL_ACCOUNT_DIALOG=true

APP_NAME=YERH
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US
APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=yerh
DB_USERNAME=yerh
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
CACHE_STORE=database
QUEUE_CONNECTION=database

MAIL_MAILER=log
# Active email notifications (sends emails alongside in-app alerts when MAIL_MAILER is configured).
YERH_MAIL_NOTIFICATIONS=true
# Example Brevo / Mailgun / Resend SMTP settings (replace placeholders with your credentials):
# MAIL_MAILER=smtp
# MAIL_HOST=smtp-relay.brevo.com
# MAIL_PORT=587
# MAIL_USERNAME=your-smtp-login@smtp-brevo.com
# MAIL_PASSWORD=your-smtp-key
# MAIL_SCHEME=smtp
# Set true in the private local .env to enable the on-page verification button.
YERH_LOCAL_EMAIL_VERIFICATION=false
MAIL_FROM_ADDRESS=notifications@example.test
MAIL_FROM_NAME="${APP_NAME}"

MOODLE_URL=
MOODLE_TOKEN=

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI="${APP_URL}/api/v1/auth/google/callback"
